rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Konfigurace (claudeKey apod.) — přístup jen přes admin SDK (Cloud Functions),
    // klient nikdy (tajemství nesmí být čitelné z prohlížeče)
    match /config/{doc} {
      allow read, write: if false;
    }
    // Výjimka (4.63): admin aplikace si přečte config/admins (pole uids: seznam uid), podle toho klient ukáže správu výzev.
    // Jen get vlastního záznamu; list a zápis dál zakazuje pravidlo výše (pravidla se sčítají, tohle povolí jen get).
    match /config/admins {
      allow get: if request.auth != null && request.auth.uid in resource.data.uids;
    }
    // Admin aplikace = uid v config/admins.uids (dokument zakládá ručně Adam v konzoli Firebase)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    // Uživatelská data — jen vlastník má přístup
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rate-limit počítadlo AI volání — mimo strom users/**, aby ho nešlo
    // přepsat obecným wildcard pravidlem výše. Zapisuje jen Cloud Function
    // přes Admin SDK (ten rules ignoruje), klient smí jen číst svůj vlastní.
    match /rateLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Rodinná skupina — hlavní dokument
    match /families/{familyId} {
      // Get konkrétního dokumentu: každý přihlášený — kód skupiny je ID
      // dokumentu a funguje jako tajemství (potřebné pro join-by-code)
      allow get: if request.auth != null;
      // List celé kolekce: nikdo — jinak by šla vypsat jména členů všech rodin
      allow list: if false;
      // Vytvoření: přihlášený uživatel, který je v members,
      // a ID skupiny má nový formát WORD-XXXXXX (slova = FAMILY_WORDS v app.js,
      // 6 znaků z abecedy ABCDEFGHJKMNPQRSTUVWXYZ23456789 = bez I, L, O, 0, 1;
      // ~887 mil. kombinací na slovo, kód nejde uhodnout). Starý formát WORD-NNNN
      // už vytvořit nejde; existující skupiny s ním dál fungují (get/update).
      // Limit členů: max 8 (hlavní skupina 6, vedlejší 8 – typ v dokumentu není, proto maximum).
      // Zakladatel je jediný člen, je správce a kód = ID dokumentu
      allow create: if request.auth != null
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[request.auth.uid].role == 'admin'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == familyId
        && familyId.matches('^(ADAM|ANNA|BARA|DOMA|ELAN|FARA|HANA|JANA|KARA|LARA|MARA|NORA|PATA|RANA|SARA|TARA)-[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{6}$');
      // Aktualizace: max 8 členů (viz create); zmenšování skupiny (odchod/odebrání) projde vždy.
      // Dál podle role volajícího:
      //  - správce (role 'admin') smí měnit cokoli (odebrání člena, předání role…)
      //  - běžný člen smí měnit sdílení a název; v members jen svůj klíč
      //    (odchod přes deleteField), svou roli nesmí zvýšit
      //  - ne-člen smí POUZE přidat sám sebe jako 'member' (join přes kód)
      allow update: if request.auth != null
        && (request.resource.data.members.size() <= 8 || request.resource.data.members.size() < resource.data.members.size())
        && (isFamilyAdmin() || isFamilyMemberUpdate() || isSelfJoin());
      allow delete: if false;

      function membersDiff() {
        return request.resource.data.members.diff(resource.data.members);
      }
      // Volající je ve skupině správcem (podle stavu PŘED zápisem)
      function isFamilyAdmin() {
        return request.auth.uid in resource.data.members
          && resource.data.members[request.auth.uid].get('role', '') == 'admin';
      }
      // Běžný člen: jen pole sdílení/názvu a vlastní klíč v members.
      // Při odchodu klíč v request.resource chybí → kontrola role se přeskočí.
      // Změna vlastního záznamu (jméno/avatar): bez povýšení, bez změny joinedAt, jméno max 40 znaků.
      function isFamilyMemberUpdate() {
        return request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['groupName', 'shareShop', 'shareCal', 'shareMeal', 'shareChecklist', 'members'])
          && membersDiff().affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in membersDiff().affectedKeys())
              || !(request.auth.uid in request.resource.data.members)
              || (request.resource.data.members[request.auth.uid].get('role', 'member') == 'member'
                  && request.resource.data.members[request.auth.uid].get('joinedAt', '') == resource.data.members[request.auth.uid].get('joinedAt', '')
                  && request.resource.data.members[request.auth.uid].get('name', '').size() <= 40));
      }
      // Join: ne-člen přidá jen sebe, s rolí 'member' a jen poli, která posílá klient
      function isSelfJoin() {
        return !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && membersDiff().addedKeys().hasOnly([request.auth.uid])
          && membersDiff().addedKeys().size() == 1
          && membersDiff().removedKeys().size() == 0
          && membersDiff().changedKeys().size() == 0
          && request.resource.data.members[request.auth.uid].keys().hasOnly(['name', 'avatar', 'joinedAt', 'role'])
          && request.resource.data.members[request.auth.uid].role == 'member'
          && request.resource.data.members[request.auth.uid].get('name', '') is string
          && request.resource.data.members[request.auth.uid].get('name', '').size() <= 40
          && request.resource.data.members[request.auth.uid].get('joinedAt', '') is string;
      }
    }

    // Člen skupiny (stav dokumentu skupiny v databázi)
    function isFamMember(fid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/families/$(fid))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }
    // Správce skupiny (role 'admin' v members)
    function isFamAdmin(fid) {
      return isFamMember(fid)
        && get(/databases/$(database)/documents/families/$(fid)).data.members[request.auth.uid].get('role', '') == 'admin';
    }

    // Rodinné podkomunity (shopItems, events, meals…) — jen členové skupiny.
    // Kromě activity, shared, reactions a challenges: pravidla se sčítají (OR), ty mají vlastní přísnější pravidla níže.
    match /families/{familyId}/{subcollection}/{docId} {
      allow read, write: if !(subcollection in ['activity', 'shared', 'reactions', 'challenges']) && isFamMember(familyId);
    }

    // Aktivita skupiny (feed „Co je nového“ + push přes cron). Zapisuje flushGroupActivity v app.js.
    // Záznam nejde měnit; maže TTL (expireAt), server (Admin SDK) a správce skupiny.
    match /families/{familyId}/activity/{actId} {
      allow read: if isFamMember(familyId);
      allow create: if isFamMember(familyId)
        && request.resource.data.keys().hasOnly(['ts', 'uid', 'name', 'g', 'module', 'action', 'title', 'n', 'count', 'expireAt',
             'ref', 'val', 'to', 'em', 'rid'])
        && request.resource.data.keys().hasAll(['ts', 'uid', 'name', 'module', 'action', 'title', 'n', 'count', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.module in ['shop', 'cal', 'meal', 'check', 'pantry', 'habit', 'goal', 'react', 'challenge', 'note', 'recipe']
        && request.resource.data.action in ['add', 'edit', 'del', 'done', 'clear', 'plan', 'share', 'streak', 'progress']
        // Cíl: jen mezník (progress, val 25/50/75) a splnění (done); progress nepatří jinému modulu
        && (request.resource.data.module != 'goal' || request.resource.data.action in ['progress', 'done'])
        && (request.resource.data.module != 'goal' || request.resource.data.get('val', -1) in [25, 50, 75, 100])
        && (request.resource.data.action != 'progress' || request.resource.data.module == 'goal')
        // Společná výzva (4.43): jen založení (add) a splnění (done)
        && (request.resource.data.module != 'challenge' || request.resource.data.action in ['add', 'done'])
        // Sdílená poznámka a recept (4.44): jen nasdílení (share), úprava aktivitu nevytváří
        && (!(request.resource.data.module in ['note', 'recipe']) || request.resource.data.action == 'share')
        // Osobní moduly: ref = zrcadlo / cíl reakce, val = délka série / mezník cíle v %, to + em = reakce,
        // rid = ID komentáře (text se sem nekopíruje, čte se z reactions → smazaný komentář zmizí všude)
        && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.size() <= 200))
        && (!('val' in request.resource.data) || (request.resource.data.val is int && request.resource.data.val >= 0 && request.resource.data.val <= 1000))
        && (!('to' in request.resource.data) || (request.resource.data.to is string && request.resource.data.to.size() <= 128))
        && (!('em' in request.resource.data) || (request.resource.data.em is string && request.resource.data.em.size() <= 40))
        && (!('rid' in request.resource.data) || (request.resource.data.rid is string && request.resource.data.rid.matches('^c_[A-Za-z0-9]{1,40}$')))
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (!('g' in request.resource.data) || (request.resource.data.g is string && request.resource.data.g.size() <= 2))
        && request.resource.data.n is int && request.resource.data.count is int
        && request.resource.data.n >= 0 && request.resource.data.n <= request.resource.data.count
        && request.resource.data.count >= 1 && request.resource.data.count <= 500
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(8, 'd');
      allow update: if false;
      // Autor (úklid při zrušení sdílení položky) a správce skupiny
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isFamAdmin(familyId));
    }

    // Sdílené položky (zrcadlo osobního návyku 'h', cíle 'g', poznámky 'n' nebo receptu 'r'): sid = type_uid_itemId, čte člen, píše jen vlastník.
    // Jen nutná pole: u návyku a cíle souhrn (žádné logy, popisy ani názvy podcílů), u poznámky nadpis a text, u receptu recept.
    function validHabitMirror(fid, sid) {
      let d = request.resource.data;
      return isFamMember(fid)
        && d.ownerUid == request.auth.uid
        && d.type == 'h'
        && d.itemId is string && d.itemId.matches('^[A-Za-z0-9_-]{1,128}$')
        && sid == d.type + '_' + request.auth.uid + '_' + d.itemId
        && d.updatedAt == request.time
        && d.keys().hasOnly(['type', 'ownerUid', 'itemId', 'updatedAt', 'arch', 'name', 'emoji', 'freq', 'htype', 'goal',
             'doneDate', 'value', 'streak', 'best', 'last7', 'paused', 'ms'])
        && d.keys().hasAll(['type', 'ownerUid', 'itemId', 'updatedAt', 'name'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && (!('arch' in d) || d.arch is bool)
        && (!('paused' in d) || d.paused is bool)
        && (!('htype' in d) || d.htype in ['check', 'count'])
        && (!('freq' in d) || (d.freq is map && d.freq.keys().hasOnly(['type', 'times', 'days'])
             && d.freq.get('type', 'daily') in ['daily', 'weekly', 'days']
             && (!('times' in d.freq) || (d.freq.times is int && d.freq.times >= 1 && d.freq.times <= 7))
             && (!('days' in d.freq) || (d.freq.days is list && d.freq.days.size() <= 7))))
        && (!('goal' in d) || (d.goal is int && d.goal >= 0 && d.goal <= 100000))
        && (!('value' in d) || (d.value is int && d.value >= 0 && d.value <= 100000))
        && (!('streak' in d) || (d.streak is int && d.streak >= 0 && d.streak <= 100000))
        && (!('best' in d) || (d.best is int && d.best >= 0 && d.best <= 100000))
        // Datum 'YYYY-MM-DD' nebo prázdné (klient posílá '' bez splnění za 60 dní)
        && (!('doneDate' in d) || (d.doneDate is string && d.doneDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')))
        && (!('last7' in d) || (d.last7 is string && d.last7.size() <= 7))
        && (!('ms' in d) || (d.ms is map && d.ms.keys().hasOnly(['v', 'd']) && d.ms.v is int && d.ms.d is string && d.ms.d.size() <= 10));
    }
    // Cíl (4.42): název, ikona, barva, pokrok %, termín, den splnění, mezníky, počet podcílů (sd/sn),
    // u měřitelného cíle start / cíl / aktuální hodnota a jednotka
    function validGoalMirror(fid, sid) {
      let d = request.resource.data;
      return isFamMember(fid)
        && d.ownerUid == request.auth.uid
        && d.type == 'g'
        && d.itemId is string && d.itemId.matches('^[A-Za-z0-9_-]{1,128}$')
        && sid == d.type + '_' + request.auth.uid + '_' + d.itemId
        && d.updatedAt == request.time
        && d.keys().hasOnly(['type', 'ownerUid', 'itemId', 'updatedAt', 'arch', 'name', 'emoji', 'color', 'progress',
             'deadline', 'doneAt', 'msHit', 'sd', 'sn', 'metric'])
        && d.keys().hasAll(['type', 'ownerUid', 'itemId', 'updatedAt', 'name', 'progress'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && (!('arch' in d) || d.arch is bool)
        && (!('color' in d) || (d.color is string && d.color.matches('^#[0-9A-Fa-f]{3,8}$')))
        && d.progress is int && d.progress >= 0 && d.progress <= 100
        // Datum 'YYYY-MM-DD' nebo prázdné (bez termínu / nesplněno)
        && (!('deadline' in d) || (d.deadline is string && d.deadline.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')))
        && (!('doneAt' in d) || (d.doneAt is string && d.doneAt.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')))
        && (!('msHit' in d) || (d.msHit is list && d.msHit.size() <= 4 && d.msHit.hasOnly([25, 50, 75, 100])))
        && (!('sn' in d) || (d.sn is int && d.sn >= 0 && d.sn <= 1000))
        && (!('sd' in d) || (d.sd is int && d.sd >= 0 && 'sn' in d && d.sd <= d.sn))
        && (!('metric' in d) || (d.metric is map
             && d.metric.keys().hasOnly(['start', 'target', 'cur', 'unit'])
             && d.metric.keys().hasAll(['start', 'target', 'cur'])
             && d.metric.start is number && d.metric.start >= -1000000000 && d.metric.start <= 1000000000
             && d.metric.target is number && d.metric.target >= -1000000000 && d.metric.target <= 1000000000
             && d.metric.cur is number && d.metric.cur >= -1000000000 && d.metric.cur <= 1000000000
             && (!('unit' in d.metric) || (d.metric.unit is string && d.metric.unit.size() <= 8))));
    }
    // Společná pole zrcadla: vlastník, typ, ID položky, čas zápisu ze serveru
    function mirrorBase(fid, sid, type) {
      let d = request.resource.data;
      return isFamMember(fid)
        && d.ownerUid == request.auth.uid
        && d.type == type
        && d.itemId is string && d.itemId.matches('^[A-Za-z0-9_-]{1,128}$')
        && sid == d.type + '_' + request.auth.uid + '_' + d.itemId
        && d.updatedAt == request.time;
    }
    // Poznámka (4.44): jen nadpis a text výslovně sdílené poznámky (bez nálady, fotky a data), text do 20 000 znaků
    function validNoteMirror(fid, sid) {
      let d = request.resource.data;
      return mirrorBase(fid, sid, 'n')
        && d.keys().hasOnly(['type', 'ownerUid', 'itemId', 'updatedAt', 'title', 'text'])
        && d.keys().hasAll(['type', 'ownerUid', 'itemId', 'updatedAt', 'title', 'text'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && d.text is string && d.text.size() <= 20000;
    }
    // Recept (4.44): název, čas, porce, druh jídla, suroviny (max 60), postup (max 40 kroků), tip.
    // Délky položek seznamů pravidla neověří (bez cyklů), ořezává je klient; dokument má limit 1 MiB.
    function validRecipeMirror(fid, sid) {
      let d = request.resource.data;
      return mirrorBase(fid, sid, 'r')
        && d.keys().hasOnly(['type', 'ownerUid', 'itemId', 'updatedAt', 'name', 'time', 'portions', 'mealType', 'ingredients', 'steps', 'tip'])
        && d.keys().hasAll(['type', 'ownerUid', 'itemId', 'updatedAt', 'name', 'ingredients', 'steps'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && (!('time' in d) || (d.time is string && d.time.size() <= 40))
        && (!('portions' in d) || (d.portions is int && d.portions >= 1 && d.portions <= 100))
        && (!('mealType' in d) || (d.mealType is string && d.mealType.size() <= 30))
        && d.ingredients is list && d.ingredients.size() <= 60
        && d.steps is list && d.steps.size() <= 40
        && (!('tip' in d) || (d.tip is string && d.tip.size() <= 1000));
    }
    function validMirror(fid, sid) {
      return (request.resource.data.type == 'h' && validHabitMirror(fid, sid))
        || (request.resource.data.type == 'g' && validGoalMirror(fid, sid))
        || (request.resource.data.type == 'n' && validNoteMirror(fid, sid))
        || (request.resource.data.type == 'r' && validRecipeMirror(fid, sid));
    }
    match /families/{familyId}/shared/{sid} {
      allow read: if isFamMember(familyId);
      allow create: if validMirror(familyId, sid);
      allow update: if resource.data.ownerUid == request.auth.uid && validMirror(familyId, sid);
      // Vlastník i po odchodu nebo odebrání (úklid), správce kvůli odebraným členům
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isFamAdmin(familyId));
    }

    // Reakce (👏 🔥 ❤️ 💪, kind 'e') a krátké komentáře (kind 'c') na sdílenou položku (s_<sid>) nebo záznam feedu (a_<id>).
    // Emoji: rid = target_uid_em (nejde dát dvakrát), komentář: c_<autoId> (nesmí mít tvar emoji reakce). Mění se jen smazáním; maže TTL expireAt (30 dní).
    match /families/{familyId}/reactions/{rid} {
      allow read: if isFamMember(familyId);
      allow create: if isFamMember(familyId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.to is string && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 128
        && request.resource.data.to != request.auth.uid
        && request.resource.data.target is string && request.resource.data.target.matches('^(a|s)_[A-Za-z0-9_-]{1,200}$')
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(31, 'd')
        && ((request.resource.data.kind == 'e'
             && request.resource.data.em in ['clap', 'fire', 'heart', 'strong']
             && rid == request.resource.data.target + '_' + request.auth.uid + '_' + request.resource.data.em
             && request.resource.data.keys().hasOnly(['kind', 'target', 'to', 'uid', 'em', 'ts', 'expireAt']))
          || (request.resource.data.kind == 'c'
             && rid.matches('^c_[A-Za-z0-9]{1,40}$')
             && request.resource.data.text is string
             && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
             && request.resource.data.keys().hasOnly(['kind', 'target', 'to', 'uid', 'text', 'ts', 'expireAt'])));
      allow update: if false;
      // Autor; adresát (komentář pod svou položkou); správce (moderace)
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || resource.data.to == request.auth.uid || isFamAdmin(familyId));
    }

    // Společné výzvy skupiny (4.43): families/{gid}/challenges/{cid}. Týmové, ne soupeřivé.
    // Založí kdokoli ze skupiny. kind 'sum' = součet příspěvků do cíle (target), 'daily' = každý den každý (target = počet dní).
    // Příspěvky v mapě p: klíč = uid, zapisuje jen jeho vlastník ({n} u součtu, {n, d:[dny], j:den přidání} u denní výzvy,
    // n == počet dní, d nejvýš 28 různých položek, j v rozsahu výzvy a po přidání se nemění; obsah d filtruje klient).
    // Konec: endAt (poledne dne po posledním dni = rezerva 12 h) nebo ended:true (zakladatel / správce). Úklid: expireAt = endAt + 30 dní
    // (TTL nebo smazání kýmkoli ze skupiny po vypršení), dřív smí smazat zakladatel (jen dokud je členem) a správce.
    function validChallengeNew() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'emoji', 'kind', 'target', 'unit', 'from', 'to', 'by', 'board', 'createdAt', 'endAt', 'expireAt'])
        && d.keys().hasAll(['title', 'kind', 'target', 'from', 'to', 'by', 'board', 'createdAt', 'endAt', 'expireAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && (!('unit' in d) || (d.unit is string && d.unit.size() <= 16))
        && d.kind in ['sum', 'daily']
        && d.target is int && d.target >= 1
        && (d.kind == 'sum' ? d.target <= 100000 : d.target <= 28)
        && d.from is string && d.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.to is string && d.to.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.from <= d.to
        && d.by == request.auth.uid
        && d.board is bool
        && d.createdAt == request.time
        && d.endAt is timestamp && d.endAt > request.time && d.endAt <= request.time + duration.value(30, 'd')
        && d.expireAt is timestamp && d.expireAt == d.endAt + duration.value(30, 'd');
    }
    // Vlastní příspěvek: jen klíč p.<uid>, jen do konce výzvy (odejít z výzvy = smazat klíč jde vždy)
    function validChallengePart() {
      let d = request.resource.data;
      let o = resource.data;
      let uid = request.auth.uid;
      let np = d.get('p', {});
      let e = np.get(uid, {});
      let prev = o.get('p', {}).get(uid, {});
      let prevN = prev.get('n', 0);
      return d.diff(o).affectedKeys().hasOnly(['p'])
        && np.diff(o.get('p', {})).affectedKeys().hasOnly([uid])
        && (!(uid in np)
          || (request.time < o.endAt && o.get('ended', false) == false
            && e is map && e.keys().hasOnly(['n', 'd', 'j']) && e.keys().hasAll(['n'])
            && e.n is int && e.n >= 0 && e.n <= 100000 && e.n <= prevN + 1000
            && (o.kind == 'daily'
              ? (e.keys().hasAll(['d', 'j']) && e.d is list && e.d.size() <= 28 && e.d.toSet().size() == e.d.size()
                && e.n == e.d.size()
                && e.j is string && e.j.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && e.j >= o.from && e.j <= o.to
                && prev.get('j', e.j) == e.j)
              : e.keys().hasOnly(['n']))));
    }
    // Zakladatel a správce: název, ikona, žebříček, předčasné ukončení (nejde vrátit);
    // správce navíc smí odebrat příspěvky (odebraný člen už svůj klíč smazat nemůže)
    function validChallengeOwner(fid) {
      let d = request.resource.data;
      let o = resource.data;
      return (o.by == request.auth.uid || isFamAdmin(fid))
        && d.diff(o).affectedKeys().hasOnly(['title', 'emoji', 'board', 'ended'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && d.board is bool
        && (!('ended' in d) || d.ended is bool)
        && (o.get('ended', false) == false || d.get('ended', false) == true);
    }
    function adminDropsParts(fid) {
      return isFamAdmin(fid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p'])
        && request.resource.data.get('p', {}).diff(resource.data.get('p', {})).addedKeys().size() == 0
        && request.resource.data.get('p', {}).diff(resource.data.get('p', {})).changedKeys().size() == 0;
    }
    match /families/{familyId}/challenges/{cid} {
      allow read: if isFamMember(familyId);
      allow create: if isFamMember(familyId) && validChallengeNew();
      allow update: if isFamMember(familyId)
        && (validChallengePart() || validChallengeOwner(familyId) || adminDropsParts(familyId));
      allow delete: if request.auth != null
        && ((resource.data.by == request.auth.uid && isFamMember(familyId)) || isFamAdmin(familyId)
            || (isFamMember(familyId) && resource.data.expireAt < request.time));
    }

    // ── Veřejné výzvy (Výzva měsíce / týdne, 4.63, docs/NAVRH-VYZVA-MESICE.md) ──
    // Zakládá a moderuje jen admin aplikace (isAdmin, config/admins). Účastník: dokument = uid,
    // jen přezdívka + odškrtnuté dny. Den jde přidat / odebrat jen po jednom a jen „dnes nebo včera“
    // v některém časovém pásmu (UTC−12 až UTC+14) podle request.time.
    function pcDs(ds) {
      return ds is string && ds.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // Datum 'YYYY-MM-DD' (UTC) z časového razítka; bez parsování řetězců (porovnání dat jako textu)
    function pcPad(x) { return x < 10 ? '0' + string(x) : string(x); }
    function pcDsOf(ts) { return string(ts.year()) + '-' + pcPad(ts.month()) + '-' + pcPad(ts.day()); }
    // Den ds platí jako „dnes nebo včera“, když jeho půlnoc (UTC) leží mezi teď − 60 h a teď + 14 h:
    // od začátku dne v UTC+14 do konce následujícího dne v UTC−12
    function pcNowish(ds) {
      return pcDs(ds)
        && ds > pcDsOf(request.time - duration.value(60, 'h'))
        && ds <= pcDsOf(request.time + duration.value(14, 'h'));
    }
    // Přezdívka: 3–20 znaků, písmena (včetně češtiny a slovenštiny), číslice, mezera, _ a -; začíná písmenem nebo číslicí.
    // Bez tečky a @ (žádné e-maily ani odkazy). Pojistka na nejhrubší slova; hlavní filtr je v klientu (pcNickBad).
    // Stejný regex je v app.js (PC_NICK_RE).
    function pcNickOk(n) {
      return n is string && n.size() >= 3 && n.size() <= 20
        && n.matches('^[0-9A-Za-zÁČĎÉĚÍĹĽŇÓÔŔŘŠŤÚŮÝŽÄÖÜáčďéěíĺľňóôŕřšťúůýžäöü][0-9A-Za-zÁČĎÉĚÍĹĽŇÓÔŔŘŠŤÚŮÝŽÄÖÜáčďéěíĺľňóôŕřšťúůýžäöü _-]*$')
        && !n.lower().matches('.*(admin|lifepocket|moderat|kurv|kurev|píč|pič|pic[aeiou]|kokot|čurák|curak|zmrd|šuk|suk[aá]|prdel|hovn|debil|fuck|shit|bitch|cunt|nigg|hitler|nazi).*');
    }
    function validPubCh() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'desc', 'emoji', 'en', 'kind', 'start', 'end', 'days', 'goal', 'active',
             'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'kind', 'start', 'end', 'days', 'goal', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 300))
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && (!('en' in d) || (d.en is map && d.en.keys().hasOnly(['title', 'desc'])
             && d.en.get('title', '') is string && d.en.get('title', '').size() <= 60
             && d.en.get('desc', '') is string && d.en.get('desc', '').size() <= 300))
        && d.kind in ['month', 'week']
        && pcDs(d.start) && pcDs(d.end) && d.start <= d.end
        && d.days is int && d.days >= 1 && d.days <= 31 && (d.kind != 'week' || d.days == 7)
        && d.goal is int && d.goal >= 1 && d.goal <= d.days
        && d.active is bool
        && d.updatedAt == request.time;
    }
    match /publicChallenges/{cid} {
      // Koncept (active false) vidí jen admin; dotaz klienta proto musí mít where('active','==',true).
      // Neexistující dokument (admin ověřuje volné ID) nic neprozradí.
      allow get: if request.auth != null && (resource == null || resource.data.active == true || isAdmin());
      allow list: if request.auth != null
        && ((resource.data.active == true && request.query.limit <= 10) || isAdmin());
      allow create: if isAdmin() && validPubCh()
        && cid.matches('^(m-20[0-9]{2}-(0[1-9]|1[0-2])|w-20[0-9]{2}-W[0-5][0-9])$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validPubCh()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      // Mazat jen koncepty (dokument s účastníky by po smazání nechal podkolekci bez výzvy)
      allow delete: if isAdmin() && resource.data.active == false;

      function pc() { return get(/databases/$(database)/documents/publicChallenges/$(cid)).data; }
      // Den patří do výzvy a je „dnes nebo včera“
      function pcDayOk(x) { return pcNowish(x) && x >= pc().start && x <= pc().end; }
      function pcPartBase() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick', 'joinedAt', 'j', 'd', 'n'])
          && d.keys().hasAll(['nick', 'joinedAt', 'j', 'd', 'n'])
          && pcNickOk(d.nick)
          && d.d is list && d.d.size() <= 31 && d.d.toSet().size() == d.d.size()
          && d.n is int && d.n == d.d.size();
      }

      match /participants/{uid} {
        allow get: if request.auth != null;
        // Top 20, skupina (in po 30 uid), počty přes count() a stránky adminu. Limit v pravidle by nic nechránil
        // (stránkování) a dotaz count() limit nemá; dokument obsahuje jen přezdívku a dny (veřejné v žebříčku).
        allow list: if request.auth != null;
        // Přihlášení: jen sám za sebe, do aktivní výzvy, ne zablokovaný; j = den přihlášení (nebo první den výzvy
        // při přihlášení předem), nejvýš 1 den (dnes nebo včera)
        allow create: if request.auth != null && request.auth.uid == uid
          && pc().active == true
          && !exists(/databases/$(database)/documents/publicChallenges/$(cid)/blocked/$(uid))
          && pcPartBase()
          && request.resource.data.joinedAt == request.time
          && pcDs(request.resource.data.j) && request.resource.data.j >= pc().start && request.resource.data.j <= pc().end
          && request.resource.data.d.size() <= 1
          && (request.resource.data.d.size() == 0 || pcDayOk(request.resource.data.d[0]));
        // Změna: přezdívka, nebo přesně +1 den, nebo přesně −1 den (oprava překliku); vždy jen dnes/včera
        allow update: if request.auth != null && request.auth.uid == uid
          && pc().active == true
          && pcPartBase()
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.j == resource.data.j
          && (request.resource.data.d == resource.data.d
            || (request.resource.data.d.size() == resource.data.d.size() + 1
                && request.resource.data.d.hasAll(resource.data.d)
                && pcDayOk(request.resource.data.d.removeAll(resource.data.d)[0]))
            || (request.resource.data.d.size() == resource.data.d.size() - 1
                && resource.data.d.hasAll(request.resource.data.d)
                && pcNowish(resource.data.d.removeAll(request.resource.data.d)[0])));
        // Odhlášení z výzvy (smaže i dny) nebo odebrání adminem
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
      // Blokace odebraných účastníků ({at}); čte a píše jen admin
      match /blocked/{uid} {
        allow read, write: if isAdmin();
      }
    }
  }
}
