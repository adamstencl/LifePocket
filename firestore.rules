rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Konfigurace (claudeKey apod.) — přístup jen přes admin SDK (Cloud Functions),
    // klient nikdy (tajemství nesmí být čitelné z prohlížeče)
    match /config/{doc} {
      allow read, write: if false;
    }

    // Uživatelská data — jen vlastník má přístup
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rate-limit počítadlo AI volání — mimo strom users/**, aby ho nešlo
    // přepsat obecným wildcard pravidlem výše. Zapisuje jen Cloud Function
    // přes Admin SDK (ten rules ignoruje), klient smí jen číst svůj vlastní.
    match /rateLimits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Rodinná skupina — hlavní dokument
    match /families/{familyId} {
      // Get konkrétního dokumentu: každý přihlášený — kód skupiny je ID
      // dokumentu a funguje jako tajemství (potřebné pro join-by-code)
      allow get: if request.auth != null;
      // List celé kolekce: nikdo — jinak by šla vypsat jména členů všech rodin
      allow list: if false;
      // Vytvoření: přihlášený uživatel, který je v members
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      // Aktualizace: stávající člen NEBO ne-člen, který POUZE přidává sám sebe
      // do members (join přes kód) — nic jiného měnit nesmí
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 1
          && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
          && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
        )
      );
      allow delete: if false;
    }

    // Rodinné podkomunity (shopItems, events, meals…) — jen členové skupiny
    match /families/{familyId}/{subcollection}/{docId} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/families/$(familyId))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }
  }
}
